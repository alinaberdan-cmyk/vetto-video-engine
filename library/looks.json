 "grades": [
  {
   "id": "natural",
   "name": "Natural",
   "ffmpeg": "",
   "css": "none"
  },
  {
   "id": "warm",
   "name": "Warm",
   "ffmpeg": "colorbalance=rs=.06:gs=.02:bs=-.06:rm=.05:bm=-.05,eq=saturation=1.08",
   "css": "sepia(.18) saturate(1.12)"
  },
  {
   "id": "cool",
   "name": "Cool",
   "ffmpeg": "colorbalance=rs=-.05:bs=.07:rm=-.03:bm=.05",
   "css": "hue-rotate(-8deg) saturate(.95) brightness(1.02)"
  },
  {
   "id": "cinematic",
   "name": "Cinematic",
   "ffmpeg": "colorbalance=rs=-.08:bs=.10:rh=.08:bh=-.08,eq=contrast=1.12:saturation=.92,vignette=PI/5",
   "css": "contrast(1.12) saturate(.9) hue-rotate(-6deg)"
  },
  {
   "id": "editorial",
   "name": "Editorial",
   "ffmpeg": "eq=contrast=1.15:saturation=.72:brightness=.01",
   "css": "contrast(1.15) saturate(.72)"
  },
  {
   "id": "film",
   "name": "Vintage film",
   "ffmpeg": "curves=preset=vintage,noise=alls=10:allf=t,vignette=PI/4",
   "css": "sepia(.32) contrast(.92) saturate(.85)"
  },
  {
   "id": "bw",
   "name": "Black & white",
   "ffmpeg": "hue=s=0,eq=contrast=1.12",
   "css": "grayscale(1) contrast(1.12)"
  },
  {
   "id": "punchy",
   "name": "Punchy",
   "ffmpeg": "eq=contrast=1.18:saturation=1.3",
   "css": "contrast(1.18) saturate(1.3)"
  },
  {
   "id": "soft",
   "name": "Soft pastel",
   "ffmpeg": "eq=contrast=.9:saturation=.85:brightness=.04,colorbalance=rh=.04:bh=.04",
   "css": "contrast(.9) saturate(.85) brightness(1.06)"
  },
  {
   "id": "clean-contrast",
   "name": "Clean contrast (Clean White)",
   "ffmpeg": "eq=contrast=1.14:brightness=-.01:saturation=1.02,colorbalance=bs=.05:bm=.02",
   "css": "contrast(1.14) brightness(.99) hue-rotate(-4deg)"
  },
  {
   "id": "neon-presenter",
   "name": "Neon presenter (Neon Dimension)",
   "ffmpeg": "eq=contrast=1.2:brightness=-.05:saturation=1.08,colorbalance=rs=-.10:bs=.14:rm=-.04:bm=.08:bh=.08,vignette=PI/4.5,noise=alls=9:allf=t",
   "css": "contrast(1.2) brightness(.92) saturate(1.08) hue-rotate(12deg)"
  },
  {
   "id": "night",
   "name": "Night neon",
   "ffmpeg": "eq=contrast=1.2:saturation=1.25:brightness=-.04,colorbalance=bs=.12:rh=.06",
   "css": "contrast(1.2) saturate(1.25) brightness(.95) hue-rotate(10deg)"
  }
 ],
 "caption_anims": [
  {
   "id": "pop",
   "name": "Pop",
   "note": "the spoken word grows a little and takes the highlight colour"
  },
  {
   "id": "bounce",
   "name": "Bounce",
   "note": "each word springs in (70% → 115% → 100%)"
  },
  {
   "id": "karaoke",
   "name": "Karaoke fill",
   "note": "the highlight fills each word as it is said"
  },
  {
   "id": "reveal",
   "name": "Word by word",
   "note": "words appear only when they are said"
  },
  {
   "id": "rise",
   "name": "Fade up",
   "note": "each line fades in and slides up"
  },
  {
   "id": "box",
   "name": "Box on the word",
   "note": "a coloured box sits behind the spoken word"
  },
  {
   "id": "glow",
   "name": "Glow",
   "note": "the spoken word glows in the highlight colour"
  },
  {
   "id": "punch",
   "name": "One big word",
   "note": "one word at a time, large, with a small punch-in"
  },
  {
   "id": "still",
   "name": "Still",
   "note": "no motion, the spoken word only changes colour"
  },
  {
   "id": "blurin",
   "name": "Blur-in (Clean White)",
   "note": "words appear as they are said, blurring in (14 px → 0 in 0.2 s), soft white glow, no box or stroke"
  },
  {
   "id": "lexicon",
   "name": "Cut on the word (Cinema Lexicon)",
   "note": "1–3 small words cut hard on the spoken word, no motion; the key word alone and big (caps or italic); low on your take, mid-frame on example clips, dark on cream cards"
  },
  {
   "id": "glowpop",
   "name": "Glow pop (Neon Dimension)",
   "note": "1–2 words in glowing caps, each chunk pops 112 % → 100 % in 0.09 s"
  },
  {
   "id": "slam",
   "name": "Slam + keyword block",
   "note": "each line slams in (130% → 100%), its longest word gets a colour block (idea: lemo-opuscar caption-news, our own numbers)"
  }
 ]
}